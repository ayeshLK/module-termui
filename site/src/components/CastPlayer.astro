---
// A terminal recording that can be paused, scrubbed and selected. Casts are served from this site
// (public/casts), recorded from the real programs. Without scripts the reader gets a link, and the
// text a page puts in the "fallback" slot, which should say what the recording shows.
interface Props {
	cast: string; // file name under public/casts
	rows?: number;
	cols?: number;
	speed?: number;
	idleTimeLimit?: number;
	poster?: string; // the frame shown before play, as "npt:MM:SS"
	autoplay?: boolean; // start playing on load, unless the reader prefers reduced motion
	loop?: boolean;
	caption?: string;
}

const { cast, rows, cols, speed = 1, idleTimeLimit = 2, poster = 'npt:0:1', autoplay = false, loop = false, caption } = Astro.props;
const hasFallback = Astro.slots.has('fallback');
const src = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/casts/${cast}`;
---

<figure class="cast">
	<div
		class="cast-host"
		data-src={src}
		data-rows={rows}
		data-cols={cols}
		data-speed={speed}
		data-idle={idleTimeLimit}
		data-poster={poster}
		data-autoplay={autoplay}
		data-loop={loop}
	>
	</div>
	<noscript>
		<p>This recording needs scripts. <a href={src}>Download the recording</a> (asciinema format).</p>
		{hasFallback && <div class="cast-fallback"><slot name="fallback" /></div>}
	</noscript>
	{caption && <figcaption set:html={caption} />}
</figure>

<script>
	import * as AsciinemaPlayer from 'asciinema-player';
	import 'asciinema-player/dist/bundle/asciinema-player.css';

	document.querySelectorAll<HTMLElement>('.cast-host').forEach((host) => {
		const { src, rows, cols, speed, idle, poster, autoplay, loop } = host.dataset;
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		AsciinemaPlayer.create(src!, host, {
			rows: rows ? Number(rows) : undefined,
			cols: cols ? Number(cols) : undefined,
			speed: Number(speed),
			idleTimeLimit: Number(idle),
			fit: 'width',
			theme: 'asciinema',
			preload: true,
			poster,
			autoPlay: autoplay === 'true' && !reduceMotion,
			loop: loop === 'true',
		});
	});
</script>

<style>
	.cast {
		margin: 1.5rem 0;
	}
	.cast-fallback :global(pre) {
		overflow-x: auto;
		font-size: var(--sl-text-sm);
	}
	figcaption {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		margin-top: 0.5rem;
	}
</style>
