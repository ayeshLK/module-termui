---
// An illustration of the update/view loop for the counter. It is written in JavaScript and models only
// the shape of the loop (message, update, view, frame); it is not the termui runtime. The runnable
// program is examples/counter. It uses the same panel and the same owner colours as the Flow diagram above
// it: the keys are outside the program (dashed), update is your code (green), the frame is the runtime's
// (blue).
const example = 'https://github.com/ayeshLK/module-termui/tree/main/examples/counter';
---

<div class="loop dg-figure dg-panel not-content" data-loop>
	<p class="loop-note">
		An illustration in JavaScript of the shape of the loop, not the termui runtime. The real program is{' '}
		<a href={example}>examples/counter</a>.
	</p>
	<noscript>
		<p class="loop-fallback">This illustration needs scripts. The counter program above shows the same loop.</p>
	</noscript>
	<div class="loop-grid" hidden data-live>
		<section class="loop-outside">
			<h4><span class="loop-num" aria-hidden="true">1</span>Send a message</h4>
			<div class="loop-keys">
				<button type="button" data-key="+">press +</button>
				<button type="button" data-key="-">press -</button>
				<button type="button" data-key="x">press x</button>
				<button type="button" data-key="q">press q</button>
			</div>
			<p class="loop-hint">Each press is a <code>KeyEvent</code> message put on the queue.</p>
		</section>
		<section class="loop-yours">
			<h4><span class="loop-num" aria-hidden="true">2</span>update(message)</h4>
			<pre data-update>waiting for a message</pre>
			<h5>State</h5>
			<pre data-state>count = 0</pre>
		</section>
		<section class="loop-runtime">
			<h4><span class="loop-num" aria-hidden="true">3</span>view() &rarr; frame</h4>
			<pre class="loop-frame" data-frame></pre>
			<p class="loop-hint" data-hint></p>
		</section>
	</div>
</div>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-loop]')) {
		const live = root.querySelector<HTMLElement>('[data-live]')!;
		const updateEl = root.querySelector<HTMLElement>('[data-update]')!;
		const stateEl = root.querySelector<HTMLElement>('[data-state]')!;
		const frameEl = root.querySelector<HTMLElement>('[data-frame]')!;
		const hintEl = root.querySelector<HTMLElement>('[data-hint]')!;
		const buttons = root.querySelectorAll<HTMLButtonElement>('button[data-key]');
		let count = 0;
		let quit = false;
		let lastFrame: string[] = [];

		const view = () => [`count: ${count}`, '+ and - change it, q quits'];
		const draw = () => {
			const frame = view();
			const changed = frame.filter((line, i) => line !== lastFrame[i]).length;
			frameEl.textContent = frame.join('\n');
			hintEl.textContent = lastFrame.length === 0
				? 'The first frame draws every cell.'
				: changed === 0
					? 'The frame is unchanged, so nothing is written.'
					: 'Only the cells that changed are written.';
			lastFrame = frame;
		};
		const send = (key: string) => {
			if (quit) return;
			let note: string;
			if (key === '+') {
				count += 1;
				note = 'count += 1\nreturns ()';
			} else if (key === '-') {
				count -= 1;
				note = 'count -= 1\nreturns ()';
			} else if (key === 'q') {
				quit = true;
				note = 'returns quit()';
			} else {
				note = 'not a key it knows\nreturns ()';
			}
			updateEl.textContent = `update(KeyEvent "${key}")\n${note}`;
			stateEl.textContent = `count = ${count}`;
			if (quit) {
				frameEl.textContent += '\n(program ended)';
				hintEl.textContent = 'quit() ends the loop and releases the terminal.';
				buttons.forEach((b) => (b.disabled = true));
				return;
			}
			draw();
		};
		buttons.forEach((b) => b.addEventListener('click', () => send(b.dataset.key!)));
		live.hidden = false;
		draw();
	}
</script>

<style>
	.loop-note,
	.loop-hint,
	.loop-fallback {
		margin: 0.5rem 0;
		font-size: var(--sl-text-sm);
		color: var(--dg-muted);
	}
	.loop-note {
		margin-top: 0;
	}
	.loop-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		align-items: start;
		margin-top: 1rem;
	}
	.loop-grid[hidden] {
		display: none;
	}
	section {
		min-width: 0;
		padding: 0.8rem;
		border: 1px solid var(--dg-border);
		border-radius: var(--dg-radius);
		background: var(--sl-color-bg);
	}
	.loop-outside {
		border-style: dashed;
	}
	.loop-yours {
		border-color: var(--dg-yours);
	}
	.loop-runtime {
		border-color: var(--dg-runtime);
	}
	h4 {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 0.6rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--dg-text);
	}
	h5 {
		margin: 0.7rem 0 0.4rem;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--dg-muted);
	}
	.loop-num {
		display: grid;
		place-items: center;
		flex: none;
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 50%;
		border: 1px solid var(--dg-border);
		font-size: var(--sl-text-xs);
		font-weight: 700;
		color: var(--dg-muted);
	}
	.loop-outside .loop-num {
		border-style: dashed;
	}
	.loop-yours .loop-num {
		border-color: var(--dg-yours);
		background: var(--dg-yours-bg);
		color: var(--dg-yours-text);
	}
	.loop-runtime .loop-num {
		border-color: var(--dg-runtime);
		background: var(--dg-runtime-bg);
		color: var(--dg-runtime-text);
	}
	pre {
		margin: 0;
		padding: 0.55rem 0.7rem;
		min-height: 2.6rem;
		white-space: pre-wrap;
		border-radius: 0.4rem;
		background: var(--dg-panel);
		border: 1px solid var(--dg-border);
		font-family: var(--sl-font-mono);
		font-size: 0.78rem;
		color: var(--dg-text);
	}
	.loop-frame {
		background: #14161b;
		border-color: #2c303a;
		color: #dfe3ea;
	}
	.loop-keys {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.4rem;
	}
	button {
		font: inherit;
		font-size: var(--sl-text-sm);
		padding: 0.35rem 0.5rem;
		min-height: 2.1rem;
		border: 1px solid var(--dg-border);
		border-radius: var(--dg-radius);
		background: var(--dg-panel);
		color: var(--dg-text);
		cursor: pointer;
	}
	button:hover:not(:disabled) {
		border-color: var(--dg-runtime);
	}
	button:focus-visible {
		outline: 2px solid var(--dg-runtime);
		outline-offset: 2px;
	}
	button:disabled {
		opacity: 0.5;
		cursor: default;
	}
	@container (max-width: 40rem) {
		.loop-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
